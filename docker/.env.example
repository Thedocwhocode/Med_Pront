# ============================================================
# Med_Pront — Environment Variables Template
# Copy to docker/.env and fill all values before running
# NEVER commit docker/.env to version control
# ============================================================

# --- Database (MariaDB) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=openemr
MYSQL_USER=openemr
MYSQL_PASSWORD=

# --- OpenEMR Admin ---
OE_USER=admin
OE_PASS=

# --- Domain & TLS ---
TRAEFIK_DOMAIN=yourdomain.com
TRAEFIK_EMAIL=admin@yourdomain.com

# --- Cloudflare ---
CF_API_TOKEN=
CF_TUNNEL_TOKEN=

# --- SMTP ---
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- WhatsApp Business API ---
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=appointment_reminder

# --- Integration Service ---
INTEGRATION_SECRET_KEY=
OPENEMR_API_URL=http://openemr/apis/default
OPENEMR_CLIENT_ID=
OPENEMR_CLIENT_SECRET=
